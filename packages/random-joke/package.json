{
  "name": "@scope/plugin-random-joke",
  "version": "0.2.0",
  "description": "A Random Joke plugin for Red Hat Developer Hub",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "dist-dynamic"
  ],
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "random-joke",
    "pluginPackages": [
      "@scope/plugin-random-joke"
    ]
  },
  "scalprum": {
    "name": "scope.plugin-random-joke",
    "exposedModules": {
      "PluginRoot": "./src/index.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc --build",
    "clean": "rimraf dist dist-dynamic",
    "typecheck": "tsc --noEmit",
    "export-dynamic": "npx @red-hat-developer-hub/cli@latest plugin export",
    "package:oci": "npx @red-hat-developer-hub/cli@latest plugin package --tag ${REGISTRY}/plugin-random-joke:${VERSION}"
  },
  "peerDependencies": {
    "@backstage/core-components": "^0.16.0",
    "@backstage/core-plugin-api": "^1.10.0",
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.0.0",
    "react-use": "^17.4.0"
  },
  "devDependencies": {
    "@backstage/core-components": "^0.16.0",
    "@backstage/core-plugin-api": "^1.10.0",
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3",
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "react-use": "^17.4.0",
    "rimraf": "^5.0.5",
    "typescript": "~5.3.3"
  }
}
